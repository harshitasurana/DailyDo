<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <%- include('navbar') %>
        <div>
            <h1>Task List page</h1>

            <div class="task-list">
            <% result.forEach(result=>{%>
                <div class="task-item">
                    <h2><%= result.title %></h2>
                    <p><%= result.description %></p>

                    <div class="task-actions">
                        <a href="/update/<%=result._id%>" class="edit-btn">Edit</a>
                        <a href="/delete?id=<%=result._id%>" class="delete-btn">Delete</a>
                    </div>

                </div>
            <%})%>
            </div>
        </div>


</body>

</html>